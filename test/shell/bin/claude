#!/usr/bin/env bash
# Stand-in for Claude Code in the shell tests: replies with the text it was sent, in capitals.
input=$(cat)
text=$(sed -n '/^BEGIN /,/^END /p' <<< "$input" | sed '1d;$d')
python3 - "${text^^}" <<'PY'
import json, sys
print(json.dumps({'type': 'system', 'subtype': 'init', 'tools': [], 'mcp_servers': []}))
print(json.dumps({'type': 'result', 'is_error': False, 'stop_reason': 'end_turn', 'result': sys.argv[1]}))
PY
