#!/usr/bin/env bash
# Stand-in for voxtype-audio-bridge in the shell tests: speech-like peaks, about 30 a second.
# $VOXTYPE_OSD_TEST_DIR/bridge-mode can make it misbehave: "garbage" writes junk lines between
# good ones, "exit" quits straight away as if the bridge crashed.
echo "voxtype-audio-bridge" >> "$VOXTYPE_OSD_TEST_DIR/calls.log"
MODE="$(cat "$VOXTYPE_OSD_TEST_DIR/bridge-mode" 2>/dev/null)"
[ "$MODE" = exit ] && exit 1
while true; do
    if [ "$MODE" = garbage ]; then
        printf 'not json\n{"peak":\n{"peak":"loud"}\n\n' || exit 0
    fi
    printf '{"peak":0.0%d}\n' $((RANDOM % 10)) || exit 0
    sleep 0.033
done
