#!/usr/bin/env bash
# Tripwire: the extension talks to systemd over D-Bus, so any systemctl call is a bug. It is
# recorded in calls.log, which the shell tests compare against exactly, and fails.
echo "systemctl $*" >> "$VOXTYPE_OSD_TEST_DIR/calls.log"
echo "systemctl $*" >> "$VOXTYPE_OSD_TEST_DIR/systemctl-calls.log"
exit 1
