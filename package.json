{
  "name": "voxtype-gnome-osd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf build && tsc",
    "test": "tsc --noEmit -p . && tsc -p tsconfig.test.json && node --test 'build-test/test/*.test.js'",
    "install-extension": "./scripts/install.sh",
    "pack": "./scripts/pack.sh",
    "test:shell": "npm run build && node --test --test-reporter=spec test/shell/shell.test.mjs"
  },
  "devDependencies": {
    "@girs/gnome-shell": "50.0.4",
    "@types/node": "^24.13.4",
    "typescript": "^5.9.3"
  }
}
